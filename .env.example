LLM_PROVIDER=groq
GROQ_API_KEY=your-key-here
MODEL_NAME=openai/gpt-oss-120b
CLASSIFIER_MODEL_NAME=openai/gpt-oss-20b
REQUEST_TIMEOUT_S=30
MAX_RETRIES=3
LOG_LEVEL=INFO
CHECKPOINT_DB_PATH=chat_history.sqlite
MAX_CONTEXT_TOKENS=6000
CLASSIFIER_CONFIDENCE_THRESHOLD=0.6
CRISIS_REGION=US
MAX_INPUT_CHARS=4000
PERSIST_HISTORY=false
LOG_FORMAT=text
# HTTP API: comma-separated user:key pairs (use long random keys)
API_KEYS=
API_AUTH_DISABLED=false
RATE_LIMIT_PER_MINUTE=20
# Optional LangSmith tracing (sends message content to LangSmith; off by default)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
